{
  "name": "frooky",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "initializeCommand": "bash .devcontainer/host-services-start.sh",
  "containerEnv": {
    "APPIUM_URL": "http://host.docker.internal:4723",
    "": "host.docker.internal:27042",
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-bashhistory,target=/commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-python-venv,target=/opt/venv,type=volume",
    "source=${localWorkspaceFolderBasename}-gradle-cache,target=/home/vscode/.gradle,type=volume",
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/frooky/agent/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /commandhistory ${containerWorkspaceFolder}/frooky/agent/node_modules /home/vscode/.gradle /opt/venv && .devcontainer/setup-arm64-android-configure-gradle.sh && echo 'source /opt/venv/bin/activate' >> ~/.bashrc && echo 'source /opt/venv/bin/activate' >> ~/.zshrc && ./compileAgent.sh --dev && pip install -e \".[dev]\"",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "./features/appium": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "biomejs.biome",
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}
