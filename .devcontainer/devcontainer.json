{
  "name": "frooky",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "initializeCommand": "bash .devcontainer/host-services-start.sh",
  "containerEnv": {
    "APPIUM_URL": "http://host.docker.internal:4723",
    "FRIDA_HOST": "host.docker.internal:27042",
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-bashhistory,target=/commandhistory,type=volume",
    "source=${localWorkspaceFolderBasename}-python-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${localWorkspaceFolderBasename}-gradle-cache,target=/home/vscode/.gradle,type=volume",
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/frooky/agent/node_modules,type=volume",
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /commandhistory ${containerWorkspaceFolder}/frooky/agent/node_modules /home/vscode/.gradle ${containerWorkspaceFolder}/.venv && .devcontainer/setup-arm64-android-configure-gradle.sh && echo 'source ${containerWorkspaceFolder}/.venv/bin/activate' >> ~/.bashrc && echo 'source ${containerWorkspaceFolder}/.venv/bin/activate' >> ~/.zshrc && uv sync && uv run compile-agent --dev",
  "features": {
    "./features/appium": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "yzhang.markdown-all-in-one",
        "fwcd.kotlin",
        "ms-vscode.cpptools",
        "redhat.vscode-yaml"
      ]
    }
  }
}
