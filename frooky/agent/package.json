{
  "name": "frooky-agent",
  "version": "0.1.0",
  "description": "Frooky frida agent.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:zodSchema": "npx ts-to-zod --all",
    "build:prod:android": "node build.js android -c",
    "build:dev:android": "node build.js android",
    "build:watch:android": "node build.js android -t frida -w",
    "test:android": "npx frida-test -U -f 'com.google.android.dialer' ./src/android ./src/shared ./src/native ./src/FrookyAgent.test.ts"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.9",
    "chokidar": "^5.0.0",
    "frida-compile": "^19.0.4",
    "frida-java-bridge": "^7.0.11",
    "frida-objc-bridge": "^8.0.5",
    "frida-swift-bridge": "^3.0.2",
    "frida-test": "^0.4.0",
    "ts-to-zod": "^5.1.0",
    "eslint": "^10.9.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "allowScripts": {
    "frida@17.18.0": true
  }
}
