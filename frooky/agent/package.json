{
  "name": "frooky-agent",
  "version": "0.2.1",
  "description": "Frooky frida agent.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:zodSchema": "npx ts-to-zod --all",
    "build:jsonSchema": "npx tsx scripts/generateJsonSchema.ts",
    "build:prod:android": "node build.js android -c",
    "build:dev:android": "node build.js android",
    "build:watch:android": "node build.js android -t frida -w",
    "test:android": "bash scripts/test-android.sh ./src/android ./src/shared ./src/native ./src/FrookyAgent.test.ts"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.12.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "chokidar": "^5.0.0",
    "eslint": "^10.12.0",
    "frida-compile": "^19.1.0",
    "frida-java-bridge": "7.0.13",
    "frida-objc-bridge": "^8.0.6",
    "frida-swift-bridge": "^3.0.2",
    "frida-test": "^0.4.0",
    "ts-to-zod": "^5.1.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "ts-to-zod": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "frida@17.22.1": true
  }
}
